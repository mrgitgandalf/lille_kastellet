# Neon Postgres – server-side connection string
# Finn under "Connection Details" i Neon-dashbordet
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Ably – server-side API key (root). Brukes til å publisere events
# og signere kortvarige klient-tokens via /api/ably-token.
# Finn under "API Keys" i Ably-dashbordet.
ABLY_API_KEY=xVLyHQ.xxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
